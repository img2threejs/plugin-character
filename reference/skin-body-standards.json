{
  "schema": "skin-body-standards/1",
  "neutral_allowlist": ["abdomen", "waist-left", "waist-right", "cheek-left", "cheek-right", "face", "hair"],
  "stages": [
    {"id":"S1", "checks":[
      {"id":"source-hash", "stage":"S1", "metric":"source_hash", "comparator":"exists", "threshold":null, "unit":"sha256", "tag":"behaviour", "case":"Source admission; robin-bikini-transfer-01/ATTRIBUTION.txt:4-8", "rationale":"Record the source identity; a hash does not establish permission."},
      {"id":"original-unchanged", "stage":"S1", "metric":"original_changed_bytes", "comparator":"==", "threshold":0, "unit":"sources", "tag":"behaviour", "case":"Original preservation; robin-bikini-transfer-01/native/transplant_head.py:411-430", "rationale":"Count sources whose content hash differs from its independently pinned digest; this is not a changed-byte count."}
    ]},
    {"id":"S2", "checks":[
      {"id":"body-pixels", "stage":"S2", "metric":"original_body_changed_pixels", "comparator":"==", "threshold":0, "unit":"pixels", "tag":"behaviour", "case":"Exact body copy; robin-bikini-transfer-01/native/transplant_head.py:447-469", "rationale":"Original body pixels must be preserved."},
      {"id":"opaque", "stage":"S2", "metric":"nonopaque_pixels", "comparator":"==", "threshold":0, "unit":"pixels", "tag":"behaviour", "case":"Opaque uint8 body; robin-bikini-transfer-01/native/transplant_head.py:447-469", "rationale":"No transparent atlas pixels."},
      {"id":"bit-depth", "stage":"S2", "metric":"image_bit_depth", "comparator":"==", "threshold":8, "unit":"bits", "tag":"behaviour", "case":"Opaque uint8 atlas; robin-bikini-transfer-01/native/transplant_head.py:447-469", "rationale":"Stored atlas samples are 8-bit."},
      {"id":"atlas-space", "stage":"S2", "metric":"atlas_color_space", "comparator":"==", "threshold":"sRGB", "unit":"color-space", "tag":"behaviour", "case":"Base colour; robin-bikini-transfer-01/native/transplant_head.py:382-403", "rationale":"Base colour is sRGB."},
      {"id":"atlas-layout", "stage":"S2", "metric":"atlas_layout_error", "comparator":"==", "threshold":0, "unit":"pixels", "tag":"behaviour", "case":"2048x2304 and 4096x4608; robin-bikini-transfer-01/README.md:112-113", "rationale":"Composite height is 9W/8."},
      {"id":"repair-boundary", "stage":"S2", "metric":"changed_outside_repair_mask", "comparator":"==", "threshold":0, "unit":"pixels", "tag":"behaviour", "case":"0 outside; robin-bikini-transfer-01/evidence/nape-08-blue-native.json:9-41", "rationale":"Repair does not alter pixels outside declared mask."},
      {"id":"island-tone", "stage":"S2", "metric":"island_tone_deviation", "comparator":"declared-max", "threshold":null, "unit":"encoded-rgb", "tag":"single-subject", "case":"0.08 deviation diagnostic in the Robin repair (robin-bikini-transfer-01/evidence/head-report.json:315-330); the limit is the project's, not Robin's", "rationale":"Declare the tolerated painted-tone difference between the repaired island and its reference region (evidence declared.limits.island_tone_deviation); not a visual-quality guarantee."},
      {"id":"uv-error", "stage":"S2", "metric":"uv_max_error", "comparator":"<=", "threshold":0.00001, "unit":"uv", "tag":"behaviour", "case":"UV remapping; robin-bikini-transfer-01/native/transplant_head.py:759-773", "rationale":"Corresponding UV loops remain within tolerance."},
      {"id":"normalized-uv", "stage":"S2", "metric":"normalized_uv_max_error", "comparator":"==", "threshold":0, "unit":"uv", "tag":"behaviour", "case":"Resolution-independent strip padding; robin-bikini-transfer-01/native/transplant_head.py:475-488", "rationale":"Normalized UVs match across declared resolutions."}
    ]},
    {"id":"S3", "checks":[
      {"id":"join-open", "stage":"S3", "metric":"join_open_edges", "comparator":"==", "threshold":0, "unit":"edges", "tag":"behaviour", "case":"0 open; robin-bikini-transfer-01/evidence/head-10-blue-fidelity.json:43-56", "rationale":"Declared join boundary has no open edges."},
      {"id":"join-nonmanifold", "stage":"S3", "metric":"join_nonmanifold_edges", "comparator":"==", "threshold":0, "unit":"edges", "tag":"behaviour", "case":"0 nonmanifold; robin-bikini-transfer-01/evidence/head-10-blue-fidelity.json:43-56", "rationale":"Declared join boundary has no nonmanifold edges."},
      {"id":"join-edges", "stage":"S3", "metric":"join_edge_count", "comparator":"exists", "threshold":null, "unit":"edges", "tag":"single-subject", "case":"192 edges; robin-bikini-transfer-01/evidence/head-10-blue-fidelity.json:43-56", "rationale":"Report scope, not a universal topology count."},
      {"id":"join-triangles", "stage":"S3", "metric":"join_triangle_count", "comparator":"exists", "threshold":null, "unit":"triangles", "tag":"single-subject", "case":"96 triangles; robin-bikini-transfer-01/evidence/head-10-blue-fidelity.json:43-56", "rationale":"Report the actual join triangles."},
      {"id":"face-position", "stage":"S3", "metric":"face_max_position_error", "comparator":"<=", "threshold":0.000001, "unit":"m", "tag":"behaviour", "case":"Join correspondence at 1 micrometre; robin-bikini-transfer-01/evidence/head-10-blue-fidelity.json:43-56", "rationale":"Face correspondence must be independently selected."}
    ]},
    {"id":"S4", "checks":[
      {"id":"bone-groups", "stage":"S4", "metric":"missing_bone_groups", "comparator":"==", "threshold":0, "unit":"groups", "tag":"behaviour", "case":"Semantic controls; reference job (not bundled)", "rationale":"Every selected catalogue group must be present."},
      {"id":"bone-count", "stage":"S4", "metric":"bone_count", "comparator":"exists", "threshold":null, "unit":"bones", "tag":"single-subject", "case":"80 full rig, 28 head; robin-bikini-transfer-01/native/donor_hair_rig.py:3-4", "rationale":"Count is stage-specific."},
      {"id":"hair-chains", "stage":"S4", "metric":"hair_chain_bones", "comparator":"reference-within", "threshold":null, "unit":"bones", "tag":"single-subject", "case":"Robin donor rig: 5x4 plus 2x2 = 24 bones (robin-bikini-transfer-01/native/donor_hair_rig.py:28-36); another hair needs its own declared count", "rationale":"Compare the bone count with the declared hair rig (declared.references.hair_chain_bones, tolerance 0.5 for an integer count). Only applicable when hair is declared.", "when":"hair_declared"},
      {"id":"hair-chain-layout", "stage":"S4", "metric":"hair_chain_lengths", "comparator":"==", "threshold":[2,2,4,4,4,4,4], "unit":"bones-per-chain", "tag":"single-subject", "severity":"advisory", "case":"Robin donor rig layout 5x4 plus 2x2; robin-bikini-transfer-01/native/donor_hair_rig.py:28-36", "rationale":"Advisory: this is one hair's layout, not a norm. Seven unbranched chains is only a sanity comparison for a hair declared like it.", "when":"hair_declared"}
    ]},
    {"id":"S5", "checks":[
      {"id":"weight-sum", "stage":"S5", "metric":"weight_sum_max_error", "comparator":"<=", "threshold":0.0001, "unit":"weight", "tag":"behaviour", "case":"Normalized weights; robin-bikini-transfer-01/native/donor_hair_rig.py:132-183", "rationale":"Every vertex's skin weights sum to one."},
      {"id":"influences", "stage":"S5", "metric":"weight_max_influences", "comparator":"<=", "threshold":4, "unit":"bones", "tag":"behaviour", "case":"Four strongest; robin-bikini-transfer-01/native/donor_hair_rig.py:132-183", "rationale":"At most four influences."},
      {"id":"small-weights", "stage":"S5", "metric":"weight_small_count", "comparator":"==", "threshold":0, "unit":"weights", "tag":"behaviour", "case":"Drop below 1e-4; robin-bikini-transfer-01/native/donor_hair_rig.py:132-183", "rationale":"No retained positive weight below 1e-4."},
      {"id":"mirror-difference", "stage":"S5", "metric":"mirror_max_difference", "comparator":"<=", "threshold":0.0001, "unit":"weight", "tag":"behaviour", "case":"1.99676e-6 on 681 foot pairs; robin-bikini-transfer-01/evidence/anatomy-skinning-aligned-comparison-02.json:15343-15350", "rationale":"Compare with explicit pair and bone mapping."},
      {"id":"mirror-unmatched", "stage":"S5", "metric":"mirror_unmatched_count", "comparator":"==", "threshold":0, "unit":"pairs", "tag":"behaviour", "case":"Ambiguity not a pass; reference job (not bundled)", "rationale":"No unmatched or ambiguous pairs."},
      {"id":"mirror-mapping", "stage":"S5", "metric":"mirror_mapping", "comparator":"exists", "threshold":null, "unit":"mapping", "tag":"behaviour", "case":"Side-aware pairing; robin-bikini-transfer-01/evidence/anatomy-skinning-aligned-comparison-02.json:15343-15350", "rationale":"State the tested pairs and permutation."}
    ]},
    {"id":"S6", "checks":[
      {"id":"neutral-regions", "stage":"S6", "metric":"mask_region_ids", "comparator":"==", "threshold":"neutral-allowlist", "unit":"regions", "tag":"behaviour", "case":"Neutral regions; reference-job authoring script (not bundled)", "rationale":"Only declared neutral region IDs."},
      {"id":"mask-min", "stage":"S6", "metric":"mask_min", "comparator":">=", "threshold":0, "unit":"weight", "tag":"behaviour", "case":"Normalized ellipsoids; reference-job authoring script (not bundled)", "rationale":"Mask weights are nonnegative."},
      {"id":"mask-max", "stage":"S6", "metric":"mask_max", "comparator":"<=", "threshold":1, "unit":"weight", "tag":"behaviour", "case":"Normalized ellipsoids; reference-job authoring script (not bundled)", "rationale":"Mask weights do not exceed one."},
      {"id":"mask-sum", "stage":"S6", "metric":"mask_max_sum", "comparator":"<=", "threshold":1, "unit":"weight", "tag":"behaviour", "case":"Normalize overlaps; reference-job authoring script (not bundled)", "rationale":"Overlapping regions sum to at most one."}
    ]},
    {"id":"S7", "checks":[
      {"id":"material-space", "stage":"S7", "metric":"material_base_color_space", "comparator":"==", "threshold":"sRGB", "unit":"color-space", "tag":"behaviour", "case":"Painted base colour; reference-job authoring script (not bundled)", "rationale":"Base colour texture uses sRGB."},
      {"id":"roughness", "stage":"S7", "metric":"material_roughness", "comparator":"exists", "threshold":null, "unit":"scalar", "tag":"single-subject", "case":"0.5; robin-bikini-transfer-01/history/robin-transfer-9-before-donor-head/native/build_head.py:430-461", "rationale":"Record actual material roughness."},
      {"id":"metallic", "stage":"S7", "metric":"material_metallic", "comparator":"exists", "threshold":null, "unit":"scalar", "tag":"single-subject", "case":"0; robin-bikini-transfer-01/history/robin-transfer-9-before-donor-head/native/build_head.py:430-461", "rationale":"Record actual metallic value."},
      {"id":"export-maps", "stage":"S7", "metric":"export_maps_and_sss", "comparator":"exists", "threshold":null, "unit":"observation", "tag":"behaviour", "case":"No normal/roughness maps or browser SSS; reference-job authoring script (not bundled)", "rationale":"Unavailable capabilities are unmeasured-by-export, not a pass."}
    ]},
    {"id":"S8", "checks":[
      {"id":"export-position", "stage":"S8", "metric":"export_position_error", "comparator":"declared-max", "threshold":null, "unit":"m", "tag":"single-subject", "case":"0 m in the Robin export parity (robin-bikini-transfer-01/evidence/export-parity.json:107-117)", "rationale":"Declare the position tolerance from the export format (declared.limits.export_position_error); compare independently matched native and GLB positions."},
      {"id":"export-uv", "stage":"S8", "metric":"export_uv_error", "comparator":"declared-max", "threshold":null, "unit":"uv", "tag":"single-subject", "case":"2.9802322387695312e-8 in the Robin export parity (robin-bikini-transfer-01/evidence/export-parity.json:107-117); a float32 encoding residual, rederive per export", "rationale":"Declare the UV tolerance (declared.limits.export_uv_error); compare corresponding loops."},
      {"id":"export-weight", "stage":"S8", "metric":"export_weight_error", "comparator":"declared-max", "threshold":null, "unit":"weight", "tag":"single-subject", "case":"1.48e-8 in the Robin export parity (robin-bikini-transfer-01/evidence/export-parity.json:107-117)", "rationale":"Declare the weight tolerance (declared.limits.export_weight_error); compare corresponding joint weights."},
      {"id":"export-pixels", "stage":"S8", "metric":"export_changed_pixels", "comparator":"==", "threshold":0, "unit":"pixels", "tag":"behaviour", "case":"0 component error; robin-bikini-transfer-01/evidence/export-parity.json:327-329", "rationale":"Compare decoded exported pixels."}
    ]}
  ]
}
