{
  "schema": "skin-body-standards/1",
  "stages": [{"id":"S10", "name":"Rig, pose deformation and animation", "checks":[
    {"id":"rig-joint-section", "stage":"S10", "metric":"rig_joint_section_offset_over_h", "comparator":"reference-within", "unit":"H", "tag":"behaviour", "case":"Caller-declared joint sections", "rationale":"Compare to the declared subject reference."},
    {"id":"rig-rest-mirror", "stage":"S10", "metric":"rig_rest_mirror_error_over_h", "comparator":"reference-within", "unit":"H", "tag":"behaviour", "case":"Caller-declared symmetric pairs", "rationale":"Compare only declared symmetric pairs."},
    {"id":"rig-weight-reversal", "stage":"S10", "metric":"rig_weight_reversal_count", "comparator":"==", "threshold":0, "unit":"reversals", "tag":"behaviour", "case":"Monotone chain policy", "rationale":"No reversal outside declared transitions."},
    {"id":"rig-weight-gradient", "stage":"S10", "metric":"rig_weight_max_gradient", "comparator":"no-worse-than-baseline", "unit":"1/m", "tag":"behaviour", "case":"Caller-owned weight baseline", "rationale":"Compare against the subject field."},
    {"id":"rig-strain-p99", "stage":"S10", "metric":"rig_strain_p99__*", "comparator":"no-worse-than-baseline", "unit":"ratio", "tag":"behaviour", "case":"Per-region per-pose baseline", "rationale":"Compare every region and pose to its own baseline."},
    {"id":"rig-strain-p01", "stage":"S10", "metric":"rig_strain_p01_area_ratio__*", "comparator":"no-worse-than-baseline", "direction":"higher-is-better", "unit":"ratio", "tag":"behaviour", "case":"Per-region per-pose baseline", "rationale":"Compare each region and pose to its own baseline."},
    {"id":"rig-strain-area-case", "stage":"S10", "metric":"rig_strain_severe_area_count__*", "comparator":"==", "threshold":0, "unit":"triangles", "tag":"single-subject", "severity":"advisory", "case":"Generic severe-area diagnostic", "rationale":"Area under 0.25 is diagnostic, not a universal cutoff."},
    {"id":"rig-strain-stretch-case", "stage":"S10", "metric":"rig_strain_severe_stretch_count__*", "comparator":"==", "threshold":0, "unit":"triangles", "tag":"single-subject", "severity":"advisory", "case":"Generic severe-stretch diagnostic", "rationale":"Stretch over 2 is diagnostic."},
    {"id":"rig-quaternion-pairs", "stage":"S10", "metric":"rig_quat_antipodal_pairs", "comparator":"==", "threshold":0, "unit":"pairs", "tag":"behaviour", "case":"Quaternion sign-continuity contract", "rationale":"Avoid antipodal adjacent linear quaternion keys."},
    {"id":"rig-rebase", "stage":"S10", "metric":"rig_rebase_world_delta_error_deg", "comparator":"declared-max", "unit":"deg", "tag":"behaviour", "case":"World-delta preservation", "rationale":"Compare before and after world deltas."},
    {"id":"rig-face-rigid", "stage":"S10", "metric":"rig_face_rigid_max_over_h", "comparator":"reference-within", "unit":"H", "tag":"behaviour", "case":"Caller-selected rigid face reference", "rationale":"Face follows its declared head transform."},
    {"id":"rig-loop-angle", "stage":"S10", "metric":"rig_loop_pose_error_deg", "comparator":"declared-max", "unit":"deg", "tag":"behaviour", "case":"Caller loop endpoint tolerance", "rationale":"Use project endpoint tolerance."},
    {"id":"rig-loop-root", "stage":"S10", "metric":"rig_loop_root_error_over_h", "comparator":"declared-max", "unit":"H", "tag":"behaviour", "case":"Caller locomotion displacement", "rationale":"Remove declared locomotion displacement."},
    {"id":"rig-loop-angle-provisional", "stage":"S10", "metric":"rig_loop_pose_error_deg", "comparator":"<=", "threshold":0.5, "unit":"deg", "tag":"single-subject", "severity":"advisory", "case":"Generic provisional diagnostic; tools/anim_clip_features.py", "rationale":"Not a population threshold."},
    {"id":"rig-loop-root-provisional", "stage":"S10", "metric":"rig_loop_root_error_over_h", "comparator":"<=", "threshold":0.01, "unit":"H", "tag":"single-subject", "severity":"advisory", "case":"Generic provisional diagnostic; tools/anim_clip_features.py", "rationale":"Not a population threshold."}
  ]}]
}
